# Discord Bot Configuration
# 各国ロールに対応する別々の国庫アカウント。0は未設定（その国への寄付を無効化）。
BRAVE_TREASURY_USER_ID=0
FREEDOM_TREASURY_USER_ID=0
GLORY_TREASURY_USER_ID=0
PEACEFUL_TREASURY_USER_ID=0
DISCORD_TOKEN=your_discord_token_here
# 0: global commands. Set a server ID to sync commands only to that server.
GUILD_ID=0
# Use separate files for each environment.
SETTINGS_FILE=data/user_setting.json
ROLE_SETTINGS_FILE=data/role_probabilities.json
BACKUP_DIR=backups

# Moderator Channel ID
MCH=your_moderator_channel_id

# Database Names
DB_MINING=mining.db
DB_USERS=users.db

# Current Directory
CWD=.

# Channel IDs
CHID_MINING=your_mining_channel_id
BRAVE_CHAT=your_brave_chat_channel_id
FREEDOM_CHAT=your_freedom_chat_channel_id
GLORY_CHAT=your_glory_chat_channel_id
PEACEFUL_CHAT=your_peaceful_chat_channel_id
MINING_EXCELLENT_CHAT=your_mining_excellent_channel_id

# Role IDs
BRAVE_ROLE=your_brave_role_id
FREEDOM_ROLE=your_freedom_role_id
GLORY_ROLE=your_glory_role_id
PEACEFUL_ROLE=your_peaceful_role_id
# 採掘ロールID
MINING_ROLE=your_mining_role_id

# Emoji Aliases
BRAVE_EMOJI=your_brave_emoji
FREEDOM_EMOJI=your_freedom_emoji
GLORY_EMOJI=your_glory_emoji
PEACEFUL_EMOJI=your_peaceful_emoji
